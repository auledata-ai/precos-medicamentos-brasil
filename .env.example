# Copie para .env antes do primeiro arranque.
# No macOS use 50000, o usuário airflow da imagem. Usar `id -u` (501) quebra
# com "getpwuid(): uid not found", porque esse UID nao existe no container e o
# Docker Desktop ja traduz a posse dos arquivos. Em Linux, use `id -u`.
AIRFLOW_UID=50000
POSTGRES_USER=precos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=precos
